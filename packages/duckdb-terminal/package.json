{
  "name": "duckdb-terminal",
  "version": "0.8.4",
  "description": "DuckDB SQL Terminal powered by Gespenst",
  "type": "module",
  "module": "./dist/duckdb-terminal.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/duckdb-terminal.js"
    },
    "./style.css": "./dist/duckdb-terminal.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "generate-docs": "typedoc",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "keywords": [
    "duckdb",
    "sql",
    "shell",
    "terminal",
    "ghostty",
    "wasm",
    "repl"
  ],
  "author": "TobiLG <github@tobilg.com>",
  "license": "MIT",
  "homepage": "https://duckdb-terminal.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/duckdb-terminal.git",
    "directory": "packages/duckdb-terminal"
  },
  "bugs": {
    "url": "https://github.com/tobilg/duckdb-terminal/issues"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev113.0",
    "@gespenst/core": "0.2.0"
  },
  "dependencies": {
    "@gespenst/web-links": "0.2.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev113.0",
    "@gespenst/core": "0.2.0",
    "@types/node": "^24",
    "@wllama/wllama": "3.8.1",
    "apache-arrow": "^17.0.0",
    "jsdom": "^30.1.3",
    "typedoc": "^0.28.20",
    "uplot": "^1.6.32",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
