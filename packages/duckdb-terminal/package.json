{
  "name": "duckdb-terminal",
  "version": "0.5.5",
  "description": "DuckDB SQL Terminal powered by Ghostty terminal emulator",
  "type": "module",
  "main": "./dist/duckdb-terminal.umd.cjs",
  "module": "./dist/duckdb-terminal.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/duckdb-terminal.js",
      "require": "./dist/duckdb-terminal.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "generate-docs": "typedoc"
  },
  "keywords": [
    "duckdb",
    "sql",
    "shell",
    "terminal",
    "ghostty",
    "wasm",
    "repl"
  ],
  "author": "TobiLG <github@tobilg.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobilg/duckdb-terminal"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "ghostty-web": "^0.4.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "@types/node": "^22",
    "ghostty-web": "^0.4.0",
    "jsdom": "^30.0.1",
    "typedoc": "^0.28.20",
    "uplot": "^1.6.32",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
